# Banco MySQL (local ou provedor externo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urbanlink_flow
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=2

# Segredo aleatório com pelo menos 24 caracteres
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-24-caracteres
JWT_EXPIRES_IN=8h

# Em produção, mantenha false e aplique o schema/migrations separadamente
DB_SYNC=false
NODE_ENV=development
PORT=3000
